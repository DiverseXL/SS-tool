{
  "name": "ss-tool-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SS Tool backend foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:pages": "wrangler pages dev dist --compatibility-date 2026-11-15 --compatibility-flags nodejs_compat",
    "build": "node scripts/build-pages.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node build/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke:serv": "npm run build:server",
    "smoke:serv": "node scripts/serv-smoke-test.mjs",
    "pretest:serv": "npm run build:server",
    "test:serv": "node scripts/serv-smoke-test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "demo:seed": "tsx scripts/seed-judge-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^8.3.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "form-data": "^4.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
