{
  "name": "ss-tool-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SS Tool backend foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^8.3.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "form-data": "^4.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
