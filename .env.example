# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL
# These values must stay in sync with the POSTGRES_* variables below.
DATABASE_URL=postgresql://ss_tool:ss_tool_dev_password@localhost:5432/ss_tool

# Docker Compose database settings (development credentials only)
POSTGRES_USER=ss_tool
POSTGRES_PASSWORD=ss_tool_dev_password
POSTGRES_DB=ss_tool
POSTGRES_PORT=5432

# Dashboard (single administrator)
# Set all three values to enable /login and /dashboard. Generate a session
# secret with: openssl rand -base64 48
# ADMIN_EMAIL=operator@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# SESSION_SECRET=replace-with-at-least-32-random-characters
# SESSION_TTL_HOURS=8

# OpenServ SERV Reasoning AI evidence extraction
# Base URL defaults to https://inference-api.openserv.ai/v1
# Model defaults to gpt-5.4-mini
# SERV_API_KEY=replace-with-your-openserv-serv-api-key
# SERV_MODEL=gpt-5.4-mini
# SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Optional SERV limits (fall back to the AI_* values below)
# SERV_TIMEOUT_MS=30000
# SERV_MAX_INPUT_TOKENS=8000
# SERV_MAX_OUTPUT_TOKENS=1500

# Generic OpenAI-compatible AI extraction fallback
# Leave unset when SERV_API_KEY is configured.
# AI_BASE_URL=https://inference-api.openserv.ai/v1
# AI_API_KEY=replace-with-your-key
# AI_MODEL=gpt-5.4-mini
# Optional limits (defaults shown)
# AI_TIMEOUT_MS=30000
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_OUTPUT_TOKENS=1500
